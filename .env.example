# Celo MCP server configuration.
# Copy to .env and fill in the values you need. Every setting is optional.

# Faucet API key, required by the request_faucet_funds and
# get_faucet_request_status tools. Create one at https://faucet.celo.org/keys
# (sign in with GitHub). Testnet only. Never commit a real key — keys found in
# public repositories are revoked without notice.
# CELO_MCP_FAUCET_API_KEY=

# Celo RPC endpoint. Defaults to the public Forno node for the selected
# network. An explicit URL here wins over CELO_MCP_USE_TESTNET.
# CELO_MCP_RPC_URL=

# Use Celo Sepolia (chain ID 11142220), the live testnet, instead of mainnet.
# Alfajores is sunset and is no longer supported.
# CELO_MCP_USE_TESTNET=false

# Logging. Levels: DEBUG, INFO, WARNING, ERROR. Formats: text, json.
# CELO_MCP_LOG_LEVEL=INFO
# CELO_MCP_LOG_FORMAT=json
